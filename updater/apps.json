[
  {
    "id": "filezilla",
    "name": "FileZilla",
    "desc": "FTP, FTPS and SFTP client",
    "homepage": "https://filezilla-project.org/",
    "pageUrl": "https://filezilla-project.org/download.php?show_all=1",
    "versionRegex": "FileZilla_([0-9.]+)_macos-arm64\\.app\\.tar\\.bz2",
    "clickSelector": "a:has-text('macos-arm64.app.tar.bz2')",
    "fallbackClickSelector": "a[href*='cdn.filezilla-project.org'], a:has-text('Download')",
    "appBundle": "FileZilla.app"
  },
  {
    "id": "muse",
    "name": "Muse",
    "desc": "Muse — Your Personal AI Agent",
    "homepage": "https://ai.meta.com/",
    "pageUrl": "https://ai.meta.com/muse/download/",
    "versionRegex": "Muse[_-]?([0-9.]+)?.*\\.dmg",
    "clickSelector": ":has-text('Download for macOS'), a[href*='app-download']",
    "downloadLinkSelector": "a[aria-label='Download for macOS']",
    "appBundle": "Muse.app"
  },
  {
    "id": "comate",
    "name": "WPS Comate",
    "desc": "AI office assistant",
    "homepage": "https://comate.wps.cn/",
    "pageUrl": "https://comate.wps.cn/downloads",
    "versionRegex": "WPS(?:%20|\\s)Comate[_-]([0-9.]+)_aarch64\\.dmg",
    "clickSelector": "a:has-text('下载 Apple 芯片版')",
    "directFilePattern": "WPS(?:%20|\\s)Comate[_-][0-9.]+_aarch64\\.dmg(?:[?#]|$)",
    "appBundle": "WPS Comate.app"
  },
  {
    "id": "lingxi",
    "name": "WPS 灵犀专业版",
    "desc": "AI office assistant",
    "homepage": "https://www.lingxi.cn/",
    "pageUrl": "https://www.lingxi.cn/download",
    "versionRegex": "软件版本[^0-9]{0,20}v?([0-9.]+)",
    "clickSelector": "button:has-text('下载 macOS 版')",
    "downloadOptionSelector": "button[data-quick-download-platform='mac-arm']",
    "appBundle": "灵犀.app"
  }
]
